# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- AWS Lightsail Credentials (Optional, or configured in App Settings) ---
# AWS_ACCESS_KEY_ID: IAM access key for Lightsail operations
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"

# AWS_SECRET_ACCESS_KEY: IAM secret key for Lightsail operations
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# AWS_DEFAULT_REGION: Lightsail default target region (e.g. ap-northeast-1, us-west-2)
AWS_DEFAULT_REGION="ap-northeast-1"

# --- Cloudflare DNS Credentials (Optional, or configured in App Settings) ---
# CLOUDFLARE_API_TOKEN: Cloudflare API token with Zone.DNS edit permissions
CLOUDFLARE_API_TOKEN="cf_tok_live_example"

# CLOUDFLARE_ZONE_ID: Cloudflare Zone ID for target domain
CLOUDFLARE_ZONE_ID="cf_zone_example"

# CLOUDFLARE_RECORD_NAME: Target domain A-record to update on IP change
CLOUDFLARE_RECORD_NAME="vpn.mydomain.dev"
